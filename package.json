{
  "name": "factory-as-code",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "factory": "./scripts/factory.cjs"
  },
  "scripts": {
    "build": "node scripts/factory.cjs build",
    "ui:dev": "vite --config frontend/vite.config.ts",
    "ui:build": "tsc -p frontend/tsconfig.json && vite build --config frontend/vite.config.ts",
    "ui:typecheck": "tsc -p frontend/tsconfig.json"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@tiptap/extension-placeholder": "^3.33.1",
    "@tiptap/extension-table": "^3.33.1",
    "@tiptap/markdown": "^3.33.1",
    "@tiptap/pm": "^3.33.1",
    "@tiptap/react": "^3.33.1",
    "@tiptap/starter-kit": "^3.33.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tsx": "4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^6.4.6"
  }
}
